#!/usr/bin/make -f

export PATH := $(CURDIR)/node_modules/.bin:$(PATH)

%:
	dh $@

override_dh_auto_configure:
	npm install --ignore-scripts

override_dh_auto_build:
	# chord is the application-composition runtime imported by agent (and
	# coding-agent); it has no workspace siblings, so build it first.
	cd packages/chord && tsgo -p tsconfig.build.json
	cd packages/tui && tsgo -p tsconfig.build.json
	# Build the workspace closure the CLI needs, in dependency order:
	# chord -> tui -> telemetry -> ai -> agent -> protocol -> client -> coding-agent.
	# (server / sqlite-node are not imported by the CLI and are omitted.)
	# Each package's types/exports resolve to ./dist, so a package must be
	# built before any sibling that imports it.
	cd packages/telemetry && tsgo -p tsconfig.build.json
	# packages/ai imports per-provider model values from src/providers/data/*.json,
	# which are generated (gitignored) and absent from a bare checkout. The full
	# `npm run build` would also rewrite the committed *.models.ts /
	# models.generated.ts catalogs (churning the tree on catalog drift). Instead,
	# when data/ is missing we materialise only the per-provider JSON via
	# `hydrate-model-data` (generate-models --data-only): it writes the api-grouped
	# shape (Record<api, Record<modelId, model>>) that flattenModelCatalog
	# consumes, fetches from models.dev, and touches no .ts. When data/ is already
	# present -- e.g. pre-generated in the source tarball on a buildd -- generation
	# is skipped.
	cd packages/ai && if [ -z "$$(ls -A src/providers/data 2>/dev/null)" ]; then \
		npm run hydrate-model-data; \
	fi && \
	tsgo -p tsconfig.build.json && \
	rm -rf dist/providers/data && \
	cp -r src/providers/data dist/providers/data
	cd packages/agent && tsgo -p tsconfig.build.json
	cd packages/protocol && tsgo -p tsconfig.build.json
	cd packages/client && tsgo -p tsconfig.build.json
	cd packages/coding-agent && npm run build

override_dh_auto_install:
	debian/stage $(CURDIR)/debian/tmp/usr

override_dh_clean:
	dh_clean
	# Remove custom staging/build dirs that dh_clean does not know about,
	# so the tree is pristine for source packaging and the next build.
	rm -rf debian/.stage debian/.test-home debian/pi-coding-agent debian/tmp

override_dh_auto_test:
	# The upstream suite needs Node's TypeScript stripper, which Debian's
	# nodejs is built without (ERR_NO_TYPESCRIPT): tui runs `node --test *.ts`
	# directly and ai's lazy-module-load test spawns `node --eval` over .ts
	# sources, so neither can run on buildds. Smoke-test the built CLI instead;
	# the full suite runs in upstream CI.
	mkdir -p $(CURDIR)/debian/.test-home
	HOME=$(CURDIR)/debian/.test-home node packages/coding-agent/dist/cli.js --version

override_dh_fixperms:
	dh_fixperms
	chmod 0755 debian/pi-coding-agent/usr/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js
	chmod 0755 debian/pi-coding-agent/usr/lib/node_modules/@earendil-works/pi-coding-agent/dist/rpc-entry.js
